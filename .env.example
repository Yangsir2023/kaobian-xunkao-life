# ─────────────────────────────────────────────────────────────
# 巡考日历 · 环境变量样例
# 复制为 .env 后按需修改（.env 已在 .gitignore 中，不会上传）
# ─────────────────────────────────────────────────────────────

PORT=8787
HOST=127.0.0.1
NODE_ENV=development

# ── 数据驱动：local | cloudbase ──────────────────────────────
# local     = 本地 JSON 数据文件（默认，零配置，开箱即跑）
# cloudbase = 腾讯云开发 CloudBase 云数据库 + 云存储
DB_DRIVER=local
DATA_DIR=./data

# ── CloudBase 云开发（DB_DRIVER=cloudbase 时必填）─────────────
CLOUDBASE_ENV_ID=
CLOUDBASE_SECRET_ID=
CLOUDBASE_SECRET_KEY=
# 集合名（留空用默认值：users / reminders / refresh_tokens / audit_logs / devices）
CLOUDBASE_COLLECTION_PREFIX=

# ── 鉴权 ─────────────────────────────────────────────────────
# 生产环境必须显式设置；留空时开发模式会自动生成并落盘到 data/.jwt_secret
JWT_SECRET=
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# ── 微信 OAuth2 / OIDC 授权登录 ──────────────────────────────
# 留空 = 走 Mock 授权通道（界面会明确标注“模拟授权”，仅用于本地联调）
# 填写 = 走真实微信授权码流程（网站应用/公众号）
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_SCOPE=snsapi_login
WECHAT_REDIRECT_URI=http://127.0.0.1:8787/api/auth/wechat/callback

# ── 其他 ────────────────────────────────────────────────────
# 允许跨域的来源，* 表示全部（浏览器从 file:// 打开时也能联调）
CORS_ORIGIN=*
# 单文件上传上限（字节，默认 3MB）
UPLOAD_MAX_BYTES=3145728
